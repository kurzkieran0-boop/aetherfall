 "lines": [
  {
   "beat": 0,
   "speaker": "narrator",
   "text": "It has no eyes.",
   "start": 0.08,
   "dur": 1.166
  },
  {
   "beat": 1,
   "speaker": "narrator",
   "text": "It doesn't need them.",
   "start": 1.538,
   "dur": 0.794
  },
  {
   "beat": 2,
   "speaker": "narrator",
   "text": "It hunts one thing. Whoever speaks.",
   "start": 2.997,
   "dur": 2.076
  },
  {
   "beat": 3,
   "speaker": "cop",
   "text": "Everyone stay calm and proceed to\u2014",
   "start": 5.33,
   "dur": 1.755
  },
  {
   "beat": 5,
   "speaker": "narrator",
   "text": "Theo had never stopped talking in his life.",
   "start": 8.663,
   "dur": 2.256
  },
  {
   "beat": 6,
   "speaker": "narrator",
   "text": "It's on every report card he's ever had.",
   "start": 11.163,
   "dur": 2.35
  },
  {
   "beat": 8,
   "speaker": "narrator",
   "text": "A phone rang. Sirens. Thunder.",
   "start": 15.455,
   "dur": 2.072
  },
  {
   "beat": 9,
   "speaker": "narrator",
   "text": "It ignored all of it. Only voices.",
   "start": 17.788,
   "dur": 2.29
  },
  {
   "beat": 10,
   "speaker": "narrator",
   "text": "So Theo had an idea. A very Theo idea.",
   "start": 20.33,
   "dur": 3.326
  },
  {
   "beat": 11,
   "speaker": "theo",
   "text": "Hey! Ugly! Over here!",
   "start": 23.913,
   "dur": 1.863
  },
  {
   "beat": 12,
   "speaker": "narrator",
   "text": "He talked. Just not from where he was standing.",
   "start": 26.038,
   "dur": 2.402
  },
  {
   "beat": 13,
   "speaker": "narrator",
   "text": "Car to car. Radio to radio.",
   "start": 28.705,
   "dur": 1.92
  },
  {
   "beat": 14,
   "speaker": "narrator",
   "text": "Then the rain shorted out the last radio.",
   "start": 30.872,
   "dur": 2.044
  },
  {
   "beat": 15,
   "speaker": "ava",
   "text": "Theo! Where is it?",
   "start": 33.163,
   "dur": 1.305
  },
  {
   "beat": 17,
   "speaker": "theo",
   "text": "No! Me! I'm the loud one!",
   "start": 36.913,
   "dur": 1.906
  },
  {
   "beat": 18,
   "speaker": "narrator",
   "text": "So Theo did what he does best.",
   "start": 39.08,
   "dur": 1.954
  },
  {
   "beat": 19,
   "speaker": "narrator",
   "text": "For the first time in his life, talking was the brave thing.",
   "start": 41.288,
   "dur": 3.024
  },
  {
   "beat": 20,
   "speaker": "theo",
   "text": "Hey! Over here! Come on! Keep up!",
   "start": 44.58,
   "dur": 2.294
  },
  {
   "beat": 21,
   "speaker": "theo",
   "text": "Hello! Hello! Hello!",
   "start": 47.122,
   "dur": 1.665
  },
  {
   "beat": 22,
   "speaker": "narrator",
   "text": "Down here, a voice comes from everywhere at once.",
   "start": 49.038,
   "dur": 2.864
  },
  {
   "beat": 23,
   "speaker": "narrator",
   "text": "It dug for every echo\u2026",
   "start": 52.163,
   "dur": 1.254
  },
  {
   "beat": 24,
   "speaker": "narrator",
   "text": "\u2026until the street gave way.",
   "start": 53.663,
   "dur": 1.58
  },
  {
   "beat": 26,
   "speaker": "ava",
   "text": "You can talk now.",
   "start": 57.497,
   "dur": 0.882
  },
  {
   "beat": 27,
   "speaker": "theo",
   "text": "I think I'm good.",
   "start": 58.955,
   "dur": 0.74
  },
  {
   "beat": 28,
   "speaker": "narrator",
   "text": "For once, Theo had nothing to say.",
   "start": 60.413,
   "dur": 2.222
  }
 ],
